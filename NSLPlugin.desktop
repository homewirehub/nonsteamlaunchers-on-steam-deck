[Desktop Entry]
Type=Application
Name=NSL Decky Plugin
Name[en_US]=NSL Decky Plugin
Comment=
Comment[en_US]=
GenericName=
GenericName[en_US]=
# Dev fork (AUDIT K13): runs the locally checked-out script instead of piping
# upstream main from raw.githubusercontent.com into bash. Assumes the repo is
# checked out at ~/NonSteamLaunchers-On-Steam-Deck.
Exec=/bin/bash -c 'export logged_in_home=$(eval echo "~$(whoami)"); nohup /bin/bash "$logged_in_home/NonSteamLaunchers-On-Steam-Deck/NSLPluginInstaller.sh"'
Icon=uav
MimeType=
Path=
StartupNotify=true
Terminal=true
TerminalOptions=
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
