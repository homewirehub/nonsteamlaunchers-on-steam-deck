[Desktop Entry]
Comment[en_US]=
Comment=
# Dev fork (AUDIT K13): runs the locally checked-out script instead of piping
# upstream main from raw.githubusercontent.com into bash. Assumes the repo is
# checked out at ~/NonSteamLaunchers-On-Steam-Deck.
Exec=/bin/bash -c 'export logged_in_home=$(eval echo "~$(whoami)"); nohup /bin/bash "$logged_in_home/NonSteamLaunchers-On-Steam-Deck/NonSteamLaunchers.sh"'
GenericName[en_US]=
GenericName=
Icon=uav
MimeType=
Name[en_US]=NonSteamLaunchers
Name=NonSteamLaunchers
Path=
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
